// Account/listing foundation. SQL-only enforcement is recorded alongside migrations.
// See docs/architecture/PHYSICAL_SCHEMA_REVIEW.md before changing this design.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ListingStatus {
  DRAFT
  VALIDATING
  HELD
  PUBLISHED
  PAUSED_BY_RESERVATION
  RESOLVING_EXISTING_ACTIVITY
  REMOVED
  REJECTED
  EXPIRED
  CLOSED
}

enum PublicationCycleKind {
  INITIAL_PUBLICATION
  RENEWAL
}

enum ListingType {
  SINGLE_ITEM
  BUNDLE
}

enum ListingCategory {
  SMARTPHONES_TABLETS
  LAPTOPS
  DESKTOP_COMPUTERS
  COMPUTER_COMPONENTS_PERIPHERALS
  MONITORS
  PRINTERS_SCANNERS
  NETWORKING_DEVICES
  UPS_SMALL_BACKUP_POWER
  ACCESSORIES_SMALL_ELECTRONICS
}

enum BundleFamily {
  MOBILE
  COMPUTING
  PRINTING
  NETWORKING
  POWER_PROTECTION
}

enum ItemCondition {
  UNTESTED_UNKNOWN
  FULLY_FUNCTIONAL
  FUNCTIONAL_WITH_ISSUES
  NOT_FUNCTIONAL
}

enum MediaProcessingStatus {
  PENDING
  QUARANTINED
  APPROVED
  REJECTED
  DELETION_PENDING
  DELETED
}

model UserAccount {
  id                      String    @id @default(uuid()) @db.Uuid
  authUserId              String    @unique
  displayName             String
  adultEligibilityCheckedAt DateTime? @db.Timestamptz(3)
  adultAttestedAt         DateTime? @db.Timestamptz(3)
  adultAttestationVersion String?
  emailVerifiedAt         DateTime? @db.Timestamptz(3)
  deletedAt               DateTime? @db.Timestamptz(3)
  createdAt               DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime  @updatedAt @db.Timestamptz(3)

  listings              Listing[]
  outboxEvents          OutboxEvent[]
  passwordChangeNotices PasswordChangeNotice[]
  marketplaceRestrictions AccountMarketplaceRestriction[]
  authoredRevisions     ListingRevision[]       @relation("RevisionAuthor")
  declarations          OwnershipDeclaration[]
  publicationCycles     PublicationCycle[]
  authUser              User                    @relation(fields: [authUserId], references: [id], onDelete: Restrict)
  draftPhotoAssets      DraftPhoto[]

  @@map("user_account")
}

// Staff/audit scope only. No participant reader or staff command is mounted.
// SQL validates scopes, preserves decision history and locks the affected account.
model AccountMarketplaceRestriction {
  id             String      @id @default(uuid()) @db.Uuid
  accountId      String      @db.Uuid
  scope          String
  reason         String
  startsAt       DateTime    @db.Timestamptz(3)
  reviewAt       DateTime    @db.Timestamptz(3)
  authorizedBy   String
  appealRoute    String?
  revokedAt      DateTime?   @db.Timestamptz(3)
  revokedBy      String?
  account        UserAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, scope, startsAt], map: "account_marketplace_restriction_account_scope_start_idx")
  @@map("account_marketplace_restriction")
}

// Owner-private, synchronously materialized in-app security event. No recipient,
// credential, session reference, rendered copy or email work lives here.
model PasswordChangeNotice {
  id               String      @id @db.Uuid
  accountId        String      @db.Uuid
  eventType        String
  eventVersion     Int
  inAppWorkKey     String      @unique
  emailEligibility String
  createdAt        DateTime    @db.Timestamptz(3)
  readAt           DateTime?   @db.Timestamptz(3)
  account          UserAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@map("password_change_notice")
}

// Minimized account email intent. Private payload/job state lives separately.
model OutboxEvent {
  id               String      @id @default(uuid()) @db.Uuid
  accountId        String      @db.Uuid
  eventType        String
  eventVersion     Int
  deduplicationKey String      @unique
  createdAt        DateTime    @default(now()) @db.Timestamptz(3)
  dispatchedAt     DateTime?   @db.Timestamptz(3)
  // Private immutable snapshot for email-switch/password-change notices only.
  // Password-change erasure is monotonic under ADR-089; SQL guards enforce purpose.
  recipientEmail   String?
  account          UserAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  emailDelivery    AccountEmailDelivery?

  @@index([dispatchedAt, createdAt])
  @@map("outbox_event")
}

// Encrypted token transport and durable dispatch/recovery state. Ciphertext is
// purpose-bound with AES-256-GCM; plaintext is never copied to generic outbox data.
model AccountEmailDelivery {
  id                String      @id @default(uuid()) @db.Uuid
  outboxEventId     String      @unique @db.Uuid
  state             String      @default("READY")
  keyId             String
  ciphertext        Bytes
  expiresAt         DateTime    @db.Timestamptz(3)
  availableAt       DateTime    @default(now()) @db.Timestamptz(3)
  attemptCount      Int         @default(0)
  leaseId           String?     @db.Uuid
  leaseExpiresAt    DateTime?   @db.Timestamptz(3)
  lastErrorCode     String?
  providerMessageId String?
  acceptedAt        DateTime?   @db.Timestamptz(3)
  terminalAt        DateTime?   @db.Timestamptz(3)
  createdAt         DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @db.Timestamptz(3)
  outboxEvent       OutboxEvent @relation(fields: [outboxEventId], references: [id], onDelete: Cascade)

  @@index([state, availableAt, createdAt])
  @@index([state, leaseExpiresAt])
  @@map("account_email_delivery")
}

// Generated by Better Auth CLI; timestamps use the foundation's timestamptz precision.
// Core optional provider fields do not enable social login.
model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)
  sessions      Session[]
  accounts      Account[]
  domainAccount UserAccount?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(3)
  token     String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("account")
}

// Better Auth's shared, atomic endpoint counters. Keys contain private IP/path data.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

model Listing {
  id                    String        @id @default(uuid()) @db.Uuid
  sellerId              String        @db.Uuid
  status                ListingStatus @default(DRAFT)
  // Nullable only to insert the listing and its first revision in one transaction.
  currentRevisionNumber Int?
  expiredAt             DateTime?     @db.Timestamptz(3)
  closedAt              DateTime?     @db.Timestamptz(3)
  createdAt             DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @db.Timestamptz(3)

  seller            UserAccount        @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  revisions         ListingRevision[]  @relation("ListingRevisions")
  currentRevision   ListingRevision?   @relation("CurrentListingRevision", fields: [id, currentRevisionNumber], references: [listingId, version], onDelete: NoAction, onUpdate: NoAction)
  publicationCycles PublicationCycle[]
  draftPhotoAssets  DraftPhoto[]

  @@unique([id, currentRevisionNumber])
  @@unique([id, sellerId], map: "draft_photo_listing_owner")
  @@index([sellerId, status])
  @@map("listing")
}

model ListingRevision {
  id                      String          @id @default(uuid()) @db.Uuid
  listingId               String          @db.Uuid
  version                 Int
  authoredById            String          @db.Uuid
  listingType             ListingType
  category                ListingCategory
  bundleFamily            BundleFamily?
  title                   String
  description             String
  // Unselected in private drafts; publication still requires controlled geography.
  barangayCode            String?
  // Unselected in incomplete drafts; supported choices enforced by SQL and Zod.
  fulfillment             String?
  priceExpectation        Decimal?        @db.Decimal(12, 2)
  conditionSummary        ItemCondition?
  diagnosticSchemaVersion String?
  material                Boolean         @default(true)
  photoCommand            String?
  createdAt               DateTime        @default(now()) @db.Timestamptz(3)

  listing              Listing               @relation("ListingRevisions", fields: [listingId], references: [id], onDelete: Restrict)
  currentFor           Listing?              @relation("CurrentListingRevision")
  publicationCycles    PublicationCycle[]
  authoredBy           UserAccount           @relation("RevisionAuthor", fields: [authoredById], references: [id], onDelete: Restrict)
  itemGroups           ListedItemGroup[]
  ownershipDeclaration OwnershipDeclaration?
  media                ListingMedia[]
  draftPhotos          DraftPhotoReference[]

  @@unique([listingId, version])
  @@unique([id, listingId, authoredById], map: "draft_photo_revision_scope")
  @@unique([id, listingId, version], map: "moderation_revision_identity")
  @@index([listingId, createdAt])
  @@map("listing_revision")
}

// Each successful publication/renewal adds a cycle; never overwrite an old cycle.
model PublicationCycle {
  id             String               @id @default(uuid()) @db.Uuid
  listingId      String               @db.Uuid
  revisionNumber Int
  cycleNumber    Int
  kind           PublicationCycleKind
  confirmedById  String               @db.Uuid
  startsAt       DateTime             @db.Timestamptz(3)
  expiresAt      DateTime             @db.Timestamptz(3)
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)

  listing      Listing                           @relation(fields: [listingId], references: [id], onDelete: Restrict)
  revision     ListingRevision                   @relation(fields: [listingId, revisionNumber], references: [listingId, version], onDelete: Restrict, onUpdate: NoAction)
  confirmedBy  UserAccount                       @relation(fields: [confirmedById], references: [id], onDelete: Restrict)
  availability PublicationAvailabilityInterval[]

  @@unique([listingId, cycleNumber])
  @@unique([listingId, id])
  @@map("publication_cycle")
}

// Only time actually publicly active counts toward pilot availability.
model PublicationAvailabilityInterval {
  id        String    @id @default(uuid()) @db.Uuid
  listingId String    @db.Uuid
  cycleId   String    @db.Uuid
  startedAt DateTime  @db.Timestamptz(3)
  endedAt   DateTime? @db.Timestamptz(3)

  cycle PublicationCycle @relation(fields: [listingId, cycleId], references: [listingId, id], onDelete: Restrict, onUpdate: NoAction)

  @@index([cycleId, startedAt])
  @@map("publication_availability_interval")
}

model ListedItemGroup {
  id             String        @id @default(uuid()) @db.Uuid
  revisionId     String        @db.Uuid
  quantity       Int           @default(1)
  brand          String?
  model          String?
  approximateAge String?
  // Incomplete/invalid draft answers must not imply a derived condition.
  condition      ItemCondition?
  batteryStatus  String?
  lockStatus     String?
  knownIssues    String?
  missingParts   String?
  includedItems  String?
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)

  revision ListingRevision    @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  answers  DiagnosticAnswer[]

  @@index([revisionId])
  @@map("listed_item_group")
}

model DiagnosticAnswer {
  id            String   @id @default(uuid()) @db.Uuid
  itemGroupId   String   @db.Uuid
  schemaVersion String
  questionKey   String
  answer        Json
  detail        String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  itemGroup ListedItemGroup @relation(fields: [itemGroupId], references: [id], onDelete: Restrict)

  @@unique([itemGroupId, schemaVersion, questionKey])
  @@map("diagnostic_answer")
}

model OwnershipDeclaration {
  id           String   @id @default(uuid()) @db.Uuid
  revisionId   String   @unique @db.Uuid
  declaredById String   @db.Uuid
  textVersion  String
  attestedAt   DateTime @db.Timestamptz(3)

  revision   ListingRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  declaredBy UserAccount     @relation(fields: [declaredById], references: [id], onDelete: Restrict)

  @@map("ownership_declaration")
}

model ListingMedia {
  id                  String                @id @default(uuid()) @db.Uuid
  revisionId          String                @db.Uuid
  objectKey           String                @unique
  publicDerivativeKey String?               @unique
  contentSha256       String
  mediaType           String
  byteSize            BigInt
  processingStatus    MediaProcessingStatus @default(PENDING)
  sortOrder           Int
  retainedUntil       DateTime?             @db.Timestamptz(3)
  createdAt           DateTime              @default(now()) @db.Timestamptz(3)

  revision ListingRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)

  @@unique([revisionId, sortOrder])
  @@map("listing_media")
}

// ADR-095: original bytes never have a serving URL. Keys derive from UUIDs.
model DraftPhoto {
  id                String   @id @db.Uuid
  listingId         String   @db.Uuid
  ownerId           String   @db.Uuid
  expectedRevision  Int
  resultRevision    Int?
  contentSha256     String
  byteSize          Int
  mediaType         String
  status            String   @default("UPLOADING")
  reservedBytes     Int
  derivativeBytes   Int      @default(0)
  approvedAttemptId String?  @db.Uuid
  originalDeletedAt DateTime? @db.Timestamptz(3)
  deletedAt         DateTime? @db.Timestamptz(3)
  expiresAt         DateTime @db.Timestamptz(3)
  nextAttemptAt     DateTime @default(now()) @db.Timestamptz(3)
  executions        Int      @default(0)
  leaseId           String?  @db.Uuid
  leaseUntil        DateTime? @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  references        DraftPhotoReference[]
  attempts          DraftPhotoAttempt[]
  events            DraftPhotoEvent[]
  listing           Listing @relation(fields: [listingId, ownerId], references: [id, sellerId], onDelete: Restrict, onUpdate: NoAction)
  owner             UserAccount @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  @@unique([id, listingId, ownerId])
  @@index([ownerId])
  @@index([status, nextAttemptAt])
  @@map("draft_photo")
}

model DraftPhotoReference {
  revisionId String @db.Uuid
  photoId    String @db.Uuid
  listingId  String @db.Uuid
  ownerId    String @db.Uuid
  sortOrder  Int
  revision   ListingRevision @relation(fields: [revisionId, listingId, ownerId], references: [id, listingId, authoredById], onDelete: Restrict, onUpdate: NoAction)
  photo      DraftPhoto @relation(fields: [photoId, listingId, ownerId], references: [id, listingId, ownerId], onDelete: Restrict, onUpdate: NoAction)
  @@id([revisionId, photoId])
  @@unique([revisionId, sortOrder])
  @@map("draft_photo_reference")
}

model DraftPhotoAttempt {
  id         String @id @db.Uuid
  photoId    String @db.Uuid
  execution  Int
  outcome    String @default("PROCESSING")
  policy     String @default("synthetic-laptop-photo-v1")
  startedAt  DateTime @default(now()) @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)
  photo      DraftPhoto @relation(fields: [photoId], references: [id], onDelete: Restrict)
  @@unique([photoId, execution])
  @@map("draft_photo_attempt")
}

// Minimized immutable outbox/audit: no object keys, names, metadata or bytes.
model DraftPhotoEvent {
  id        String @id @default(uuid()) @db.Uuid
  photoId   String @db.Uuid
  kind      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  photo     DraftPhoto @relation(fields: [photoId], references: [id], onDelete: Restrict)
  @@unique([photoId, kind])
  @@map("draft_photo_event")
}

// Scoped retention records only. No staff grant or hold-write endpoint exists.
model DraftRetentionHold {
  id             String @id @default(uuid()) @db.Uuid
  listingId      String @db.Uuid
  authorizedById String @db.Uuid
  purpose        String
  startedAt      DateTime @db.Timestamptz(3)
  reviewAt       DateTime @db.Timestamptz(3)
  releasedAt     DateTime? @db.Timestamptz(3)
  releasedById   String? @db.Uuid
  @@index([listingId, releasedAt])
  @@map("draft_retention_hold")
}

// ADR-096 moderation records. The migration owns cross-record/composite FKs,
// immutable-history triggers and checks; repositories use explicit SQL projections.
// No owner binding or held request is created by generating this client.
model ModerationControl {
  singleton Boolean @id @default(true)
  ownerAccountId String? @map("owner_account_id") @db.Uuid
  installationReference String? @map("installation_reference")
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(3)
  @@map("moderation_control")
}
model ModerationGrant {
  id String @id @db.Uuid
  accountId String @map("account_id") @db.Uuid
  permission String
  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt DateTime @map("ends_at") @db.Timestamptz(3)
  trainingReference String @map("training_reference")
  authorizerId String @map("authorizer_id") @db.Uuid
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  @@index([accountId,permission],map:"moderation_grant_actor")
  @@map("moderation_grant")
}
model ModerationShift {
  id String @id @db.Uuid
  accountId String @map("account_id") @db.Uuid
  authorizerId String @map("authorizer_id") @db.Uuid
  role String
  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt DateTime @map("ends_at") @db.Timestamptz(3)
  trainingReference String @map("training_reference")
  availability String @default("SCHEDULED")
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(3)
  @@map("moderation_shift")
}
model HeldLaptopReview {
  id String @id @db.Uuid
  listingId String @map("listing_id") @db.Uuid
  revision Int
  revisionId String @unique @map("revision_id") @db.Uuid
  sellerId String @map("seller_id") @db.Uuid
  sourceReference String @unique @map("source_reference") @db.Uuid
  sourcePolicy String @map("source_policy")
  triggerClass String @map("trigger_class")
  submittedAt DateTime @map("submitted_at") @db.Timestamptz(3)
  status String @default("PENDING")
  assignedTo String? @map("assigned_to") @db.Uuid
  closedAt DateTime? @map("closed_at") @db.Timestamptz(3)
  necessityDueAt DateTime @map("necessity_due_at") @db.Timestamptz(3)
  @@index([status,submittedAt],map:"moderation_review_queue")
  @@map("held_laptop_review")
}
model ModerationConflict {
  reviewId String @map("review_id") @db.Uuid
  accountId String @map("account_id") @db.Uuid
  reason String
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  @@id([reviewId,accountId])
  @@map("moderation_conflict")
}
model ModerationRetentionException {
  id String @id @db.Uuid
  recordKind String @map("record_kind")
  recordId String @map("record_id") @db.Uuid
  authorizerId String @map("authorizer_id") @db.Uuid
  purpose String
  startedAt DateTime @map("started_at") @db.Timestamptz(3)
  reviewAt DateTime @map("review_at") @db.Timestamptz(3)
  releasedAt DateTime? @map("released_at") @db.Timestamptz(3)
  @@map("moderation_retention_exception")
}
model ModerationDecision {
  id String @id @db.Uuid
  reviewId String @map("review_id") @db.Uuid
  revisionId String @map("revision_id") @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  action String
  reasonCode String @map("reason_code")
  rationale String
  priorState String @map("prior_state")
  resultingState String @map("resulting_state")
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  appealDeadline DateTime? @map("appeal_deadline") @db.Timestamptz(3)
  correctsId String? @map("corrects_id") @db.Uuid
  @@map("moderation_decision")
}
model ModerationAppeal {
  id String @id @db.Uuid
  reviewId String @unique @map("review_id") @db.Uuid
  decisionId String @unique @map("decision_id") @db.Uuid
  grounds Json
  explanation String
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  acknowledgementDueAt DateTime @map("acknowledgement_due_at") @db.Timestamptz(3)
  decisionDueAt DateTime @map("decision_due_at") @db.Timestamptz(3)
  acknowledgedAt DateTime? @map("acknowledged_at") @db.Timestamptz(3)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(3)
  @@map("moderation_appeal")
}
model ModerationAppealResponse {
  decisionId String @map("decision_id") @db.Uuid
  ground String
  explanation String
  @@id([decisionId,ground])
  @@map("moderation_appeal_response")
}
model ModerationNotice {
  id String @id @db.Uuid
  reviewId String @map("review_id") @db.Uuid
  decisionId String? @map("decision_id") @db.Uuid
  accountId String @map("account_id") @db.Uuid
  event String
  version Int @default(1)
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  readAt DateTime? @map("read_at") @db.Timestamptz(3)
  emailOutcome String @default("INELIGIBLE") @map("email_outcome")
  @@map("moderation_notice")
}
model ModerationAudit {
  id String @id @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  grantId String? @map("grant_id") @db.Uuid
  purpose String
  action String
  targetId String @map("target_id") @db.Uuid
  revisionId String? @map("revision_id") @db.Uuid
  reason String
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  @@index([expiresAt],map:"moderation_audit_expiry")
  @@map("moderation_audit")
}
model ModerationReceipt {
  actorId String @map("actor_id") @db.Uuid
  command String
  requestId String @map("request_id") @db.Uuid
  reviewId String? @map("review_id") @db.Uuid
  fingerprint String
  result Json
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(3)
  @@id([actorId,command,requestId])
  @@map("moderation_receipt")
}
model ModerationEmailBinding {
  userId String @id @map("user_id")
  generation BigInt @default(0)
  @@map("moderation_email_binding")
}
model ModerationEmailJob {
  id String @id @db.Uuid
  noticeId String @unique @map("notice_id") @db.Uuid
  accountId String @map("account_id") @db.Uuid
  policy String @default("moderation-jobs-v1")
  bindingGeneration BigInt @map("binding_generation")
  recipient String?
  state String @default("READY")
  attempts Int @default(0)
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  deadline DateTime @db.Timestamptz(3)
  availableAt DateTime @map("available_at") @db.Timestamptz(3)
  leaseId String? @map("lease_id") @db.Uuid
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz(3)
  terminalAt DateTime? @map("terminal_at") @db.Timestamptz(3)
  outcomeCode String? @map("outcome_code")
  @@index([state,availableAt],map:"moderation_email_ready")
  @@map("moderation_email_job")
}
model ModerationEmailAttempt {
