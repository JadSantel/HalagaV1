// Account/listing foundation. SQL-only enforcement is recorded alongside migrations.
// See docs/architecture/PHYSICAL_SCHEMA_REVIEW.md before changing this design.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ListingStatus {
  DRAFT
  VALIDATING
  HELD
  PUBLISHED
  PAUSED_BY_RESERVATION
  RESOLVING_EXISTING_ACTIVITY
  REMOVED
  REJECTED
  EXPIRED
  CLOSED
}

enum PublicationCycleKind {
  INITIAL_PUBLICATION
  RENEWAL
}

enum ListingType {
  SINGLE_ITEM
  BUNDLE
}

enum ListingCategory {
  SMARTPHONES_TABLETS
  LAPTOPS
  DESKTOP_COMPUTERS
  COMPUTER_COMPONENTS_PERIPHERALS
  MONITORS
  PRINTERS_SCANNERS
  NETWORKING_DEVICES
  UPS_SMALL_BACKUP_POWER
  ACCESSORIES_SMALL_ELECTRONICS
}

enum BundleFamily {
  MOBILE
  COMPUTING
  PRINTING
  NETWORKING
  POWER_PROTECTION
}

enum ItemCondition {
  UNTESTED_UNKNOWN
  FULLY_FUNCTIONAL
  FUNCTIONAL_WITH_ISSUES
  NOT_FUNCTIONAL
}

enum MediaProcessingStatus {
  PENDING
  QUARANTINED
  APPROVED
  REJECTED
  DELETION_PENDING
  DELETED
}

model UserAccount {
  id              String    @id @default(uuid()) @db.Uuid
  authUserId      String    @unique
  displayName     String
  dateOfBirth     DateTime? @db.Date
  adultAttestedAt DateTime? @db.Timestamptz(3)
  emailVerifiedAt DateTime? @db.Timestamptz(3)
  deletedAt       DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  listings          Listing[]
  authoredRevisions ListingRevision[]      @relation("RevisionAuthor")
  declarations      OwnershipDeclaration[]
  publicationCycles PublicationCycle[]
  authUser          User                   @relation(fields: [authUserId], references: [id], onDelete: Restrict)

  @@map("user_account")
}

// Generated by Better Auth CLI; timestamps use the foundation's timestamptz precision.
// Core optional provider fields do not enable social login.
model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)
  sessions      Session[]
  accounts      Account[]
  domainAccount UserAccount?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(3)
  token     String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("account")
}

// Better Auth's shared, atomic endpoint counters. Keys contain private IP/path data.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

model Listing {
  id                    String        @id @default(uuid()) @db.Uuid
  sellerId              String        @db.Uuid
  status                ListingStatus @default(DRAFT)
  // Nullable only to insert the listing and its first revision in one transaction.
  currentRevisionNumber Int?
  expiredAt             DateTime?     @db.Timestamptz(3)
  closedAt              DateTime?     @db.Timestamptz(3)
  createdAt             DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @db.Timestamptz(3)

  seller            UserAccount        @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  revisions         ListingRevision[]  @relation("ListingRevisions")
  currentRevision   ListingRevision?   @relation("CurrentListingRevision", fields: [id, currentRevisionNumber], references: [listingId, version], onDelete: NoAction, onUpdate: NoAction)
  publicationCycles PublicationCycle[]

  @@unique([id, currentRevisionNumber])
  @@index([sellerId, status])
  @@map("listing")
}

model ListingRevision {
  id                      String          @id @default(uuid()) @db.Uuid
  listingId               String          @db.Uuid
  version                 Int
  authoredById            String          @db.Uuid
  listingType             ListingType
  category                ListingCategory
  bundleFamily            BundleFamily?
  title                   String
  description             String
  barangayCode            String
  priceExpectation        Decimal?        @db.Decimal(12, 2)
  conditionSummary        ItemCondition?
  diagnosticSchemaVersion String?
  material                Boolean         @default(true)
  createdAt               DateTime        @default(now()) @db.Timestamptz(3)

  listing              Listing               @relation("ListingRevisions", fields: [listingId], references: [id], onDelete: Restrict)
  currentFor           Listing?              @relation("CurrentListingRevision")
  publicationCycles    PublicationCycle[]
  authoredBy           UserAccount           @relation("RevisionAuthor", fields: [authoredById], references: [id], onDelete: Restrict)
  itemGroups           ListedItemGroup[]
  ownershipDeclaration OwnershipDeclaration?
  media                ListingMedia[]

  @@unique([listingId, version])
  @@index([listingId, createdAt])
  @@map("listing_revision")
}

// Each successful publication/renewal adds a cycle; never overwrite an old cycle.
model PublicationCycle {
  id             String               @id @default(uuid()) @db.Uuid
  listingId      String               @db.Uuid
  revisionNumber Int
  cycleNumber    Int
  kind           PublicationCycleKind
  confirmedById  String               @db.Uuid
  startsAt       DateTime             @db.Timestamptz(3)
  expiresAt      DateTime             @db.Timestamptz(3)
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)

  listing      Listing                           @relation(fields: [listingId], references: [id], onDelete: Restrict)
  revision     ListingRevision                   @relation(fields: [listingId, revisionNumber], references: [listingId, version], onDelete: Restrict, onUpdate: NoAction)
  confirmedBy  UserAccount                       @relation(fields: [confirmedById], references: [id], onDelete: Restrict)
  availability PublicationAvailabilityInterval[]

  @@unique([listingId, cycleNumber])
  @@unique([listingId, id])
  @@map("publication_cycle")
}

// Only time actually publicly active counts toward pilot availability.
model PublicationAvailabilityInterval {
  id        String    @id @default(uuid()) @db.Uuid
  listingId String    @db.Uuid
  cycleId   String    @db.Uuid
  startedAt DateTime  @db.Timestamptz(3)
  endedAt   DateTime? @db.Timestamptz(3)

  cycle PublicationCycle @relation(fields: [listingId, cycleId], references: [listingId, id], onDelete: Restrict, onUpdate: NoAction)

  @@index([cycleId, startedAt])
  @@map("publication_availability_interval")
}

model ListedItemGroup {
  id             String        @id @default(uuid()) @db.Uuid
  revisionId     String        @db.Uuid
  quantity       Int           @default(1)
  brand          String?
  model          String?
  approximateAge String?
  condition      ItemCondition
  batteryStatus  String?
  lockStatus     String?
  knownIssues    String?
  missingParts   String?
  includedItems  String?
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)

  revision ListingRevision    @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  answers  DiagnosticAnswer[]

  @@index([revisionId])
  @@map("listed_item_group")
}

model DiagnosticAnswer {
  id            String   @id @default(uuid()) @db.Uuid
  itemGroupId   String   @db.Uuid
  schemaVersion String
  questionKey   String
  answer        Json
  detail        String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  itemGroup ListedItemGroup @relation(fields: [itemGroupId], references: [id], onDelete: Restrict)

  @@unique([itemGroupId, schemaVersion, questionKey])
  @@map("diagnostic_answer")
}

model OwnershipDeclaration {
  id           String   @id @default(uuid()) @db.Uuid
  revisionId   String   @unique @db.Uuid
  declaredById String   @db.Uuid
  textVersion  String
  attestedAt   DateTime @db.Timestamptz(3)

  revision   ListingRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  declaredBy UserAccount     @relation(fields: [declaredById], references: [id], onDelete: Restrict)

  @@map("ownership_declaration")
}

model ListingMedia {
  id                  String                @id @default(uuid()) @db.Uuid
  revisionId          String                @db.Uuid
  objectKey           String                @unique
  publicDerivativeKey String?               @unique
  contentSha256       String
  mediaType           String
  byteSize            BigInt
  processingStatus    MediaProcessingStatus @default(PENDING)
  sortOrder           Int
  retainedUntil       DateTime?             @db.Timestamptz(3)
  createdAt           DateTime              @default(now()) @db.Timestamptz(3)

  revision ListingRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)

  @@unique([revisionId, sortOrder])
  @@map("listing_media")
}
