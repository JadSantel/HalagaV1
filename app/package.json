{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:diagnostics": "node --test tests/laptop-diagnostics.test.mjs",
    "test:listing": "node --test tests/laptop-listing.test.mjs",
    "test:photos": "node --test tests/sample-laptop-photos.test.mjs",
    "test:logging": "node --conditions=react-server --test tests/operational-logging.test.mjs",
    "db:check": "node scripts/check-database.mjs",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:migrate:local": "node scripts/migrate-local.mjs",
    "db:foundation:check": "node scripts/check-foundation-installed.mjs",
