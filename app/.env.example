# Local development only. Replace the example credentials with your local PostgreSQL role.
DATABASE_URL="postgresql://halaga:halaga@127.0.0.1:5432/halaga_dev?schema=public"

# Required by protected signup/sign-in and six account-email commands (local synthetic only).
# Password change and unrelated account endpoints remain closed; launch gates remain incomplete.
BETTER_AUTH_URL="http://127.0.0.1:3000"
# Generate your own random secret (at least 32 characters); never use a fixture in deployment.
BETTER_AUTH_SECRET=""
# Leave BETTER_AUTH_TRUSTED_ORIGINS unset; extra origins are rejected by the single-origin policy.
# Required for production/non-loopback origins. Leave unset locally.
# Set only after reviewing a proxy that overwrites this single-IP header and blocks direct origin access.
# AUTH_TRUSTED_IP_HEADER=""

# Required by the private account-email dispatcher before it can send.
# JSON: {"active":"key-2026-10","keys":{"key-2026-10":"<base64-encoded-32-byte-key>"}}
# Keep prior keys present during rotation until their pending payloads expire.
ACCOUNT_EMAIL_KEYRING=""
HALAGA_PUBLIC_ORIGIN="http://127.0.0.1:3000"
HALAGA_EMAIL_FROM=""
BREVO_API_KEY=""
# Explicit opt-in only after provider/launch readiness. A key alone never enables sends.
ACCOUNT_EMAIL_SENDING_ENABLED="false"

# ADR-095: private synthetic draft photos only. Absolute path required.
# Inside this repository only app/private-draft-photos is allowed (Git-ignored).
# Outside the repository use a private directory, never a static/source/build root.
# On Windows verify NTFS access is restricted to the local web/worker identity.
DRAFT_PHOTO_ROOT=""
# Absolute local ClamAV clamscan executable and the installed, reviewed version.
# Example version syntax only: ClamAV major.minor.patch (no default version).
# Install/verify signatures before use; absent/unhealthy scanning never approves files.
DRAFT_PHOTO_CLAMSCAN=""
DRAFT_PHOTO_CLAMSCAN_VERSION=""
